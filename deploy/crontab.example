# BestBet cron on JODA (docs/DEPLOY.md). BESTBET=/home/<user>/deploy/BestBet; secrets in its .env.
# games and snapshot need the API-HOCKEY key; until then install only the keyless lines.
# m   h   dom mon dow  command
0     6   *   *   *    cd $BESTBET && set -a && . ./.env && ./bin/ingest-hockey games    >> data/log/games.log 2>&1
10    6   *   *   *    cd $BESTBET && set -a && . ./.env && ./bin/ingest-hockey swehockey -league swe-allsvenskan -season 2026 >> data/log/swehockey.log 2>&1
30    8   *   *   *    cd $BESTBET && set -a && . ./.env && ./bin/ingest-hockey nhl -season 2026 >> data/log/nhl.log 2>&1
*/15  *   *   *   *    cd $BESTBET && set -a && . ./.env && ./bin/ingest-hockey snapshot >> data/log/snapshot.log 2>&1
20    *   *   *   *    cd $BESTBET && set -a && . ./.env && ./bin/predict               >> data/log/predict.log 2>&1
# Hint app (plan 03): live odds every 2 h for the next 36 h, then the hint ledger. Needs ODDSPAPI_KEY.
5     */2 *   *   *    cd $BESTBET && set -a && . ./.env && for l in nhl swe-allsvenskan; do ./bin/ingest-hockey oddspapi -league $l -live -books pinnacle,betano.cz,merkurxtip.cz; done >> data/log/oddspapi-live.log 2>&1 && ./bin/ingest-hockey hints >> data/log/hints.log 2>&1
# Lineups (plan 04 L2): published NHL lineups of games starting within 90 min; no game, no request.
*/10  *   *   *   *    cd $BESTBET && set -a && . ./.env && ./bin/ingest-hockey nhl-lineups >> data/log/nhl-lineups.log 2>&1
