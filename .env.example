# Copy to .env. Never commit .env. Placeholders only: no LAN addresses, no real values.
# Postgres runs on JODA (deploy/joda, docs/DEPLOY.md); no Docker on the dev Mac.
DATABASE_URL=postgres://bestbet:changeme@DB_HOST:5455/bestbet?sslmode=disable
# Opt-in integration tests create and drop their own database on this server.
TEST_DATABASE_URL=postgres://bestbet:changeme@DB_HOST:5455/postgres?sslmode=disable
MOCK_DATABASE_URL=postgres://bestbet:changeme@DB_HOST:5455/bestbet_mock?sslmode=disable
# api-sports.io dashboard key (free tier: 100 requests/day).
APIHOCKEY_KEY=changeme
APIHOCKEY_BUDGET=90
# oddspapi.io key (free tier).
ODDSPAPI_KEY=changeme
CACHE_DIR=data/cache

# cmd/api (docs/API.md)
API_ADDR=127.0.0.1:8096
API_BOOKS=tipsport,fortuna,chance,betano,synottip,sazka,merkur
API_CLV_MARKETS=
API_TOKENS=user:changeme
API_HELP=
API_TZ=Europe/Prague
